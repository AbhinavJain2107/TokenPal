{
  "name": "Pixel Fox",
  "author": "TokenPal Contributors",
  "license": "CC0-1.0",
  "frameSize": {
    "width": 32,
    "height": 32
  },
  "fps": 6,
  "spriteSheet": "spritesheet.png",
  "supportsTint": true,
  "tintPalettes": {
    "amber": "hue-rotate(20deg) saturate(1.4)",
    "sapphire": "hue-rotate(180deg) saturate(1.2)",
    "emerald": "hue-rotate(90deg) saturate(1.3)",
    "rose": "hue-rotate(310deg) saturate(1.5)",
    "violet": "hue-rotate(240deg) saturate(1.3)",
    "slate": "grayscale(100%) brightness(0.9)"
  },
  "accessoryAnchors": {
    "hat": {
      "x": 11,
      "y": 3
    },
    "glasses": {
      "x": 10,
      "y": 12
    },
    "bow": {
      "x": 15,
      "y": 23
    }
  },
  "animations": {
    "idle": {
      "from": 0,
      "to": 3
    },
    "walk": {
      "from": 4,
      "to": 7
    },
    "sleep": {
      "from": 8,
      "to": 11
    },
    "alert": {
      "from": 12,
      "to": 15
    },
    "happy": {
      "from": 16,
      "to": 19
    },
    "curious": {
      "from": 20,
      "to": 23
    }
  }
}
