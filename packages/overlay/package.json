{
  "name": "tokenpal-overlay",
  "version": "0.2.0",
  "description": "Lightweight Electron desktop mascot companion and status panel for TokenPal",
  "license": "MIT",
  "author": "Abhinav Jain",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbhinavJain2107/TokenPal.git",
    "directory": "packages/overlay"
  },
  "keywords": [
    "tokenpal",
    "electron",
    "mascot",
    "overlay",
    "companion",
    "desktop"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skins",
    "assets"
  ],
  "scripts": {
    "build": "tsc && cp src/*.html dist/ && cp -r skins dist/ && cp -r assets dist/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "tokenpal-core": "workspace:*"
  },
  "devDependencies": {
    "electron": "^33.2.1"
  }
}
